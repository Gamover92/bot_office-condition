# Token from @BotFather
BOT_TOKEN=123456:ABC...

# Public HTTPS address of the Mini App (Cloudflare Tunnel, ngrok, own domain)
WEBAPP_URL=https://climate.example.com
# Short name of the Mini App from BotFather (/newapp). Used for the button in groups.
MINIAPP_SHORT_NAME=climate

# Access. Empty = everyone. Comma-separated IDs.
# Members of ALLOWED_CHAT_IDS can also open the Mini App (the bot must be in the chat).
ALLOWED_CHAT_IDS=
ALLOWED_USER_IDS=

# MQTT (the broker from docker-compose)
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=qingping/+/up

# Device names: MAC=Name;MAC=Name
DEVICE_NAMES=582D34000000=Open space

HISTORY_DAYS=30
STALE_AFTER_MIN=30
LOG_LEVEL=INFO

# Only for the "tunnel" profile
CLOUDFLARE_TUNNEL_TOKEN=
